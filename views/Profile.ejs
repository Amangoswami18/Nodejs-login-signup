<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(to right, #6a11cb, #2575fc);
      min-height: 100vh;
    }
    .profile-card {
      border-radius: 20px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0px 8px 20px rgba(0,0,0,0.15);
      transition: transform 0.3s ease-in-out;
    }
    .profile-card:hover {
      transform: translateY(-5px);
    }
    .profile-header {
      background: linear-gradient(to right, #2575fc, #6a11cb);
      color: white;
      padding: 40px 20px;
    }
    .profile-header img {
      border: 5px solid #fff;
      margin-top: -70px;
    }
    .info-card {
      border-radius: 15px;
      box-shadow: 0px 5px 15px rgba(0,0,0,0.1);
    }
  </style>
</head>
<body>

  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
<a href="/"> <button class="btn btn-dark mb-4">Back To signup</button></a>
        <!-- Profile Card -->
        <div class="profile-card text-center">
          <div class="profile-header">
            <h2 class="fw-bold">Welcome, <%= user.name %> 🎉</h2>
            <p class="mb-0">Your Personal Dashboard</p>
          </div>

          <div class="card-body">
            <!-- Profile Picture -->
            <% if (user.profilePic) { %>
              <img src="/uploads/<%= user.profilePic %>" 
                   alt="Profile Pic" 
                   class="rounded-circle shadow mb-3" 
                   width="150" height="150">
            <% } else { %>
              <img src="https://via.placeholder.com/150" 
                   alt="Default Profile" 
                   class="rounded-circle shadow mb-3">
            <% } %>

            <!-- User Details -->
            <h4 class="fw-bold"><%= user.name %></h4>
            <p class="text-muted">📧 <%= user.email %></p>

            <div class="row mt-4">
              <div class="col-md-6 mb-3">
                <div class="p-3 bg-light info-card">
                  <h6 class="text-muted">Age</h6>
                  <h5><%= user.age %> Years</h5>
                </div>
              </div>
              <div class="col-md-6 mb-3">
                <div class="p-3 bg-light info-card">
                  <h6 class="text-muted">Account</h6>
                  <h5>Active ✅</h5>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
           <div class="mt-4">
           <a href="/edit/<%= user._id %>" class="btn btn-warning me-2">Edit Profile ✏️</a>
           <a href="/logout/<%= user._id %>" onclick="return confirm('Are you sure?')" class="btn btn-danger">Delete Profile 🚪</a>
           </div>


          </div>
        </div>

      </div>
    </div>
  </div>

</body>
</html>
